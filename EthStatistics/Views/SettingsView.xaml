<UserControl x:Class="EthStatistics.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False">

        <Grid Background="{DynamicResource AppBackgroundBrush}">

            <StackPanel
                Margin="32"
                MaxWidth="760"
                HorizontalAlignment="Left">


                <!-- ================================= -->
                <!-- PAGE HEADER -->
                <!-- ================================= -->

                <TextBlock
                    Text="Settings"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Manage your application preferences"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- ================================= -->
                <!-- LANGUAGE -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Language"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Choose the application's display language"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,6,20,0"/>

                        </StackPanel>


                        <ComboBox
                            x:Name="LanguageComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ProfessionalComboBoxStyle}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- APPEARANCE -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Appearance"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Choose the application's visual theme"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,6,20,0"/>

                        </StackPanel>


                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ProfessionalComboBoxStyle}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- MARKET DEFAULTS -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Quote Currency"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Choose your preferred quote currency for market analysis"
                                Style="{StaticResource LabelStyle}"
                                TextWrapping="Wrap"
                                Margin="0,6,20,0"/>

                        </StackPanel>


                        <ComboBox
                            x:Name="CurrencyComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ProfessionalComboBoxStyle}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- API DATA INFORMATION -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="API Market Data"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="API market analysis uses daily candles. Market and analysis period are selected from the Chart page."
                                Style="{StaticResource LabelStyle}"
                                TextWrapping="Wrap"
                                Margin="0,6,20,0"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="5"
                            Padding="12,6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="DAILY"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- STORAGE -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Saved Preferences"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Your selections are stored locally and restored when the application starts."
                                Style="{StaticResource LabelStyle}"
                                TextWrapping="Wrap"
                                Margin="0,6,20,0"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="5"
                            Padding="12,6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="LOCAL"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ================================= -->
                <!-- APPLICATION -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,22">

                    <StackPanel>

                        <TextBlock
                            Text="Application"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock
                            Text="Crypto Statistics"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,15,0,0"/>

                        <TextBlock
                            Text="Quantitative cryptocurrency analytics"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="12"
                            Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================= -->
                <!-- SAVE -->
                <!-- ================================= -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,30">

                    <Button
                        x:Name="SavePreferencesButton"
                        Content="Save Preferences"
                        Width="155"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SavePreferences_Click"/>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">

                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{DynamicResource TextMutedBrush}"
                            Margin="0,0,7,0"/>

                        <TextBlock
                            Text="Changes are also saved automatically"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="11"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>