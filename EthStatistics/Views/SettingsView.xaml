<UserControl x:Class="EthStatistics.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Background="{DynamicResource AppBackgroundBrush}">

            <StackPanel
                Margin="32"
                MaxWidth="760"
                HorizontalAlignment="Left">

                <!-- PAGE HEADER -->

                <TextBlock
                    Text="Settings"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Manage your application preferences"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- LANGUAGE -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Language"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Choose the application's display language"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,6,20,0"/>

                        </StackPanel>

                        <ComboBox
                            x:Name="LanguageComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ProfessionalComboBoxStyle}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- APPEARANCE -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Appearance"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Choose the application's visual theme"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,6,20,0"/>

                        </StackPanel>

                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ProfessionalComboBoxStyle}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- MARKET DEFAULTS -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <StackPanel>

                        <TextBlock
                            Text="Market Defaults"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock
                            Text="Choose the defaults used when loading market analysis"
                            Style="{StaticResource LabelStyle}"
                            Margin="0,6,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- QUOTE CURRENCY -->

                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Quote Currency"
                                    Style="{StaticResource LabelStyle}"
                                    Margin="0,0,0,7"/>

                                <ComboBox
                                    x:Name="CurrencyComboBox"
                                    Style="{StaticResource ProfessionalComboBoxStyle}"/>

                            </StackPanel>


                            <!-- TIMEFRAME -->

                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="Timeframe"
                                    Style="{StaticResource LabelStyle}"
                                    Margin="0,0,0,7"/>

                                <ComboBox
                                    x:Name="TimeframeComboBox"
                                    Style="{StaticResource ProfessionalComboBoxStyle}"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- STORAGE INFORMATION -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Saved Preferences"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Your selections are stored locally and restored when the application starts."
                                Style="{StaticResource LabelStyle}"
                                TextWrapping="Wrap"
                                Margin="0,6,20,0"/>

                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="5"
                            Padding="12,6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="LOCAL"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- APPLICATION INFORMATION -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,22">

                    <StackPanel>

                        <TextBlock
                            Text="Application"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock
                            Text="Crypto Statistics"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,15,0,0"/>

                        <TextBlock
                            Text="Quantitative cryptocurrency analytics"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="12"
                            Margin="0,4,0,0"/>

                        <TextBlock
                            Text="Market metadata and timeframes are provided dynamically by the active data provider."
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,12,0,0"/>

                    </StackPanel>

                </Border>


                <!-- SAVE BUTTON -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0,0,0,30">

                    <Button
                        x:Name="SavePreferencesButton"
                        Content="Save Preferences"
                        Width="155"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SavePreferences_Click"/>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">

                        <Ellipse
                            Width="6"
                            Height="6"
                            Fill="{DynamicResource TextMutedBrush}"
                            Margin="0,0,7,0"/>

                        <TextBlock
                            Text="Changes are also saved automatically"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="11"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>