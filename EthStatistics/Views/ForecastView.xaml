<UserControl x:Class="EthStatistics.Views.ForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Background="{DynamicResource AppBackgroundBrush}"
              Margin="32">

            <StackPanel>

                <!-- HEADER -->

                <TextBlock
                    Text="Forecast"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Statistical forecasting and predictive market analysis"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- FORECAST CONFIGURATION -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- MARKET -->

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,20,0">

                            <TextBlock
                                Text="MARKET"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,0,0,7"/>

                            <ComboBox
                                x:Name="ForecastMarketComboBox"
                                Style="{StaticResource ProfessionalComboBoxStyle}"/>

                        </StackPanel>


                        <!-- MODEL -->

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,20,0">

                            <TextBlock
                                Text="MODEL"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,0,0,7"/>

                            <ComboBox
                                x:Name="ForecastModelComboBox"
                                Style="{StaticResource ProfessionalComboBoxStyle}"/>

                        </StackPanel>


                        <!-- HORIZON -->

                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,20,0">

                            <TextBlock
                                Text="HORIZON"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,0,0,7"/>

                            <ComboBox
                                x:Name="ForecastHorizonComboBox"
                                Style="{StaticResource ProfessionalComboBoxStyle}"/>

                        </StackPanel>


                        <!-- RUN -->

                        <Button
                            Grid.Column="4"
                            Content="Run Forecast"
                            Width="130"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            IsEnabled="False"/>

                    </Grid>

                </Border>


                <!-- STATUS -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Forecast Engine"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Forecasting functionality has not been enabled yet"
                                Style="{StaticResource LabelStyle}"
                                Margin="0,6,0,0"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="5"
                            Padding="12,6"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="PLANNED"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- FORECAST CHART -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Height="360"
                    Margin="0,0,0,16">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Text="Forecast"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal">

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{DynamicResource AccentBrush}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Prediction"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Grid>


                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Forecast visualization"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="Historical observations and predictions will appear here"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="11"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- FUTURE METRICS -->

                <UniformGrid Columns="3">

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="FORECAST VALUE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="LOWER BOUND"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <Border
                        Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="UPPER BOUND"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>