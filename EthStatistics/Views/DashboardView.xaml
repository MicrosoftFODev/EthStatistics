<UserControl x:Class="EthStatistics.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False">

        <Grid
            Background="{DynamicResource AppBackgroundBrush}"
            Margin="32">

            <StackPanel>

                <!-- ================================= -->
                <!-- HEADER -->
                <!-- ================================= -->

                <StackPanel Margin="0,0,0,28">

                    <TextBlock
                        Text="Dashboard"
                        Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock
                        Text="Market overview and quantitative summary"
                        Style="{StaticResource PageSubtitleStyle}"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- METRICS -->
                <!-- ================================= -->

                <UniformGrid
                    Columns="4"
                    Margin="0,0,0,22">

                    <!-- LATEST VALUE -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                x:Name="PriceLabel"
                                Text="LATEST PRICE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="PriceValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                x:Name="PriceDescription"
                                Text="Latest daily close"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CHANGE -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                x:Name="ChangeLabel"
                                Text="DAILY CHANGE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="ChangeValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                x:Name="ChangeDescription"
                                Text="Previous close to latest close"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- OBSERVATIONS -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="OBSERVATIONS"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="ObservationValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                Text="Observations currently loaded"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- VOLATILITY -->

                    <Border
                        Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="ANNUALIZED VOL."
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="VolatilityValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                Text="Annualized historical volatility"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- ================================= -->
                <!-- PRICE + RSI CHART -->
                <!-- ================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Height="610">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- ================================= -->
                        <!-- HEADER -->
                        <!-- ================================= -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock
                                    Text="Daily Price"
                                    Style="{StaticResource SectionTitleStyle}"/>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Margin="0,5,0,0">

                                    <TextBlock
                                        x:Name="MarketPairText"
                                        Text="Waiting for market data"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="11"/>

                                    <TextBlock
                                        x:Name="MeanLegendText"
                                        Text=""
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="11"
                                        Margin="14,0,0,0"/>

                                </StackPanel>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Ellipse
                                    x:Name="MarketStatusIndicator"
                                    Width="7"
                                    Height="7"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Margin="0,0,7,0"/>

                                <TextBlock
                                    x:Name="MarketStatusText"
                                    Text="Waiting"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"/>

                            </StackPanel>

                        </Grid>


                        <!-- ================================= -->
                        <!-- CHART AREA -->
                        <!-- ================================= -->

                        <Grid
                            Grid.Row="1"
                            Margin="0,20,0,0"
                            SizeChanged="DashboardChart_SizeChanged">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="1.35*"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>


                            <!-- ================================= -->
                            <!-- PRICE Y AXIS -->
                            <!-- ================================= -->

                            <Grid
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,8,10,8">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Name="YAxisMaximumText"
                                    Grid.Row="0"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"/>

                                <TextBlock
                                    x:Name="YAxisUpperMiddleText"
                                    Grid.Row="2"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="YAxisMiddleText"
                                    Grid.Row="4"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="YAxisLowerMiddleText"
                                    Grid.Row="6"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    x:Name="YAxisMinimumText"
                                    Grid.Row="8"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"/>

                            </Grid>


                            <!-- ================================= -->
                            <!-- PRICE GRAPH -->
                            <!-- ================================= -->

                            <Grid
                                x:Name="DashboardGraphArea"
                                Grid.Row="0"
                                Grid.Column="1">

                                <!-- Horizontal grid lines -->

                                <Grid IsHitTestVisible="False">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"/>

                                    <Border
                                        Grid.Row="2"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"/>

                                    <Border
                                        Grid.Row="4"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"/>

                                    <Border
                                        Grid.Row="6"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"/>

                                    <Border
                                        Grid.Row="8"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"/>

                                </Grid>

                                <!-- Monthly vertical grid -->

                                <Canvas
                                    x:Name="MonthlyGridCanvas"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True"/>


                                <!-- Price + mean -->

                                <Canvas
                                    x:Name="DashboardChartCanvas"
                                    Margin="0,8,0,8"
                                    ClipToBounds="True">

                                    <Line
                                        x:Name="DashboardMeanLine"
                                        Stroke="{DynamicResource TextSecondaryBrush}"
                                        StrokeThickness="1.5"
                                        StrokeDashArray="5,3"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>

                                    <Polyline
                                        x:Name="DashboardPriceLine"
                                        Stroke="{DynamicResource AccentBrush}"
                                        StrokeThickness="2"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"/>

                                </Canvas>

                                <!-- Empty state -->

                                <StackPanel
                                    x:Name="DashboardEmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="No market data available"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"/>

                                    <TextBlock
                                        Text="Select a market from Chart or import Excel data"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="11"
                                        Margin="0,7,0,0"
                                        HorizontalAlignment="Center"/>

                                </StackPanel>

                            </Grid>

                            <!-- PRICE TITLE -->

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="PRICE"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="8"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,7,10,0"/>


                            <!-- ================================= -->
                            <!-- RSI Y AXIS -->
                            <!-- ================================= -->

                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                                <TextBlock
                                    Text="100"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"/>

                                <TextBlock
                                    Text="70"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,27,0,0"/>

                                <TextBlock
                                    Text="50"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="30"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,27"/>

                                <TextBlock
                                    Text="0"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"/>

                            </Grid>


                            <!-- ================================= -->
                            <!-- RSI GRAPH -->
                            <!-- ================================= -->

                            <!-- ================================= -->
                            <!-- RSI GRAPH -->
                            <!-- ================================= -->

                            <Grid
    Grid.Row="2"
    Grid.Column="1"
    ClipToBounds="True">

                                <Canvas
        x:Name="RsiChartCanvas"
        ClipToBounds="True">

                                    <Line
            x:Name="Rsi70Line"
            Stroke="{DynamicResource BorderSubtleBrush}"
            StrokeThickness="1"
            StrokeDashArray="4,4"/>

                                    <Line
            x:Name="Rsi50Line"
            Stroke="{DynamicResource BorderSubtleBrush}"
            StrokeThickness="1"/>

                                    <Line
            x:Name="Rsi30Line"
            Stroke="{DynamicResource BorderSubtleBrush}"
            StrokeThickness="1"
            StrokeDashArray="4,4"/>

                                </Canvas>

                                <Canvas
        x:Name="RsiSeriesCanvas"
        Background="Transparent"
        ClipToBounds="True"
        IsHitTestVisible="False"/>

                                <TextBlock
        Text="RSI (14)"
        Foreground="{DynamicResource TextMutedBrush}"
        FontSize="8"
        FontWeight="SemiBold"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="8,6,0,0"
        IsHitTestVisible="False"/>

                            </Grid>


                            <!-- ================================= -->
                            <!-- DATE AXIS -->
                            <!-- ================================= -->

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="DATE"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="8"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,7,10,0"/>

                            <Canvas
                                x:Name="MonthlyLabelsCanvas"
                                Grid.Row="3"
                                Grid.Column="1"
                                Height="38"
                                ClipToBounds="False"/>

                        </Grid>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>