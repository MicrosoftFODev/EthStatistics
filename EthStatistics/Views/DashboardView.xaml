<UserControl x:Class="EthStatistics.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Background="{DynamicResource AppBackgroundBrush}"
              Margin="32">

            <StackPanel>

                <!-- HEADER -->

                <TextBlock
                    Text="Dashboard"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Market overview and quantitative summary"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- METRICS -->

                <UniformGrid Columns="4"
                             Margin="0,0,0,22">

                    <!-- LATEST VALUE -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                x:Name="PriceLabel"
                                Text="LATEST VALUE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="PriceValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                x:Name="PriceDescription"
                                Text="Latest observation"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CHANGE -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="CHANGE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="ChangeValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                Text="Latest period"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- OBSERVATIONS -->

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="OBSERVATIONS"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="ObservationValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                Text="Current dataset"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- VOLATILITY -->

                    <Border Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="ANNUALIZED VOL."
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="VolatilityValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                            <TextBlock
                                Text="Historical volatility"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="10"
                                Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- MARKET OVERVIEW -->

                <Border Style="{StaticResource CardStyle}"
                        Height="380">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock
                                    Text="Market"
                                    Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock
                                    x:Name="MarketPairText"
                                    Text="Waiting for market data"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="11"
                                    Margin="0,5,0,0"/>

                            </StackPanel>


                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Ellipse
                                    x:Name="MarketStatusIndicator"
                                    Width="7"
                                    Height="7"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Margin="0,0,7,0"/>

                                <TextBlock
                                    x:Name="MarketStatusText"
                                    Text="Waiting"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"/>

                            </StackPanel>

                        </Grid>


                        <!-- MINI CHART -->

                        <Grid Grid.Row="1"
                              Margin="0,18,0,0"
                              SizeChanged="DashboardChart_SizeChanged">

                            <Grid IsHitTestVisible="False">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"/>

                                <Border Grid.Row="1"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"/>

                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"/>

                            </Grid>


                            <Canvas
                                x:Name="DashboardChartCanvas"
                                Margin="10"
                                ClipToBounds="True">

                                <Polyline
                                    x:Name="DashboardPriceLine"
                                    Stroke="{DynamicResource AccentBrush}"
                                    StrokeThickness="2"
                                    StrokeLineJoin="Round"/>

                            </Canvas>


                            <StackPanel
                                x:Name="DashboardEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="No market data available"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Import data or connect to a market provider"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="11"
                                    Margin="0,7,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>