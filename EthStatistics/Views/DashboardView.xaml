<UserControl x:Class="EthStatistics.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid
            Background="{DynamicResource AppBackgroundBrush}"
            Margin="32">

            <StackPanel>

                <!-- TITLE -->

                <TextBlock
                    Text="Dashboard"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Market overview and quantitative summary"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- METRICS -->

                <UniformGrid
                    Columns="4"
                    Margin="0,0,0,22">


                    <!-- PRICE -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="PRICE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="PriceValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- CHANGE -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="CHANGE"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="ChangeValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- VOLUME -->

                    <Border
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,10,0">

                        <StackPanel>

                            <TextBlock
                                Text="VOLUME"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="VolumeValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- VOLATILITY -->

                    <Border
                        Style="{StaticResource CardStyle}">

                        <StackPanel>

                            <TextBlock
                                Text="VOLATILITY"
                                Style="{StaticResource LabelStyle}"/>

                            <TextBlock
                                x:Name="VolatilityValue"
                                Text="—"
                                Style="{StaticResource MetricValueStyle}"
                                Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- MARKET CHART -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Height="380">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="Market"
                                    Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock
                                    x:Name="MarketPairText"
                                    Text="Waiting for market data"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="11"
                                    Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STATUS -->

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                <Ellipse
                                    x:Name="MarketStatusIndicator"
                                    Width="7"
                                    Height="7"
                                    Fill="{DynamicResource TextMutedBrush}"
                                    Margin="0,0,7,0"/>

                                <TextBlock
                                    x:Name="MarketStatusText"
                                    Text="Waiting"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11"/>

                            </StackPanel>

                        </Grid>


                        <!-- CHART / EMPTY STATE -->

                        <Grid Grid.Row="1">

                            <Border
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,18,0,0"/>


                            <StackPanel
                                x:Name="EmptyMarketState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Market data unavailable"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    Text="The application will refresh market data automatically"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="11"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>