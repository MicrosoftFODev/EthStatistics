<UserControl x:Class="EthStatistics.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- PAGE HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="32,30,32,0">

            <TextBlock
                Text="Chart"
                Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                Text="Historical market price and volume analysis"
                Style="{StaticResource PageSubtitleStyle}"
                Margin="0,5,0,0"/>

        </StackPanel>


        <!-- MARKET CONTROLS -->

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="32,26,32,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- MARKET -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock
                        Text="MARKET"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="MarketComboBox"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Pair"
                        Style="{StaticResource ProfessionalComboBoxStyle}"/>

                </StackPanel>


                <!-- INTERVAL -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,20,0">

                    <TextBlock
                        Text="INTERVAL"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="IntervalComboBox"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Minutes"
                        Style="{StaticResource ProfessionalComboBoxStyle}"/>

                </StackPanel>


                <!-- PERIOD -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,20,0">

                    <TextBlock
                        Text="PERIOD"
                        Style="{StaticResource LabelStyle}"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="PeriodComboBox"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Days"
                        Style="{StaticResource ProfessionalComboBoxStyle}"/>

                </StackPanel>


                <!-- AUTOMATIC REFRESH STATUS -->

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="20,0,0,9">

                    <Ellipse
                        x:Name="RefreshStatusIndicator"
                        Width="7"
                        Height="7"
                        Fill="{DynamicResource TextMutedBrush}"
                        Margin="0,0,8,0"/>

                    <TextBlock
                        x:Name="RefreshStatusText"
                        Text="Waiting"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="11"
                        VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- CHART AREA -->

        <Grid Grid.Row="2"
              Margin="32,0,32,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
            </Grid.RowDefinitions>


            <!-- PRICE -->

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- PRICE HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Price"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                x:Name="ChartMarketText"
                                Text="Waiting for market data"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="11"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- LEGEND -->

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{DynamicResource AccentBrush}"
                                Margin="0,0,7,0"/>

                            <TextBlock
                                Text="Close"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                FontSize="11"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>


                    <!-- PRICE CONTENT -->

                    <Grid Grid.Row="1"
                          Margin="0,18,0,0">

                        <Border
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"/>


                        <!-- REAL CHART GOES HERE LATER -->

                        <Grid x:Name="PriceChartContainer">

                            <StackPanel
                                x:Name="EmptyChartState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="No chart data available"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    Text="Market data will refresh automatically"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    FontSize="11"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Grid>

            </Border>


            <!-- VOLUME -->

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- VOLUME HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock
                            Text="Volume"
                            Style="{StaticResource SectionTitleStyle}"/>


                        <TextBlock
                            Grid.Column="1"
                            x:Name="VolumeMarketText"
                            Text="—"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="11"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- VOLUME CONTENT -->

                    <Grid Grid.Row="1"
                          Margin="0,12,0,0">

                        <Border
                            Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            VerticalAlignment="Bottom"/>


                        <!-- REAL VOLUME CHART GOES HERE LATER -->

                        <Grid x:Name="VolumeChartContainer">

                            <TextBlock
                                x:Name="EmptyVolumeState"
                                Text="Volume data will appear automatically"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Grid>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>