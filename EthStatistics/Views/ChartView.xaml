<UserControl x:Class="EthStatistics.Views.ChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F7FA">

        <StackPanel Margin="35">

            <TextBlock
                Text="Chart"
                FontSize="30"
                FontWeight="SemiBold"
                Foreground="#111827"/>

            <TextBlock
                Text="Historical cryptocurrency market data"
                FontSize="14"
                Foreground="#6B7280"
                Margin="0,6,0,30"/>

            <Border
                Height="400"
                Background="White"
                CornerRadius="10"
                Padding="25">

                <TextBlock
                    Text="Chart will appear here."
                    Foreground="#6B7280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>