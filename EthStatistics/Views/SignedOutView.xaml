<UserControl x:Class="EthStatistics.Views.SignedOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <Border
            Width="460"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}">

            <StackPanel>

                <Border
                    Width="64"
                    Height="64"
                    Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="32"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="CS"
                        Foreground="{DynamicResource AccentBrush}"
                        FontSize="20"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <TextBlock
                    Text="Crypto Statistics"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="26"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"/>


                <TextBlock
                    Text="Sign in to access market data, charts, statistics, forecasting, and your saved preferences."
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    LineHeight="20"
                    Margin="0,12,0,0"/>


                <Button
                    x:Name="SignInButton"
                    Content="Sign in with Microsoft"
                    Width="210"
                    Height="42"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="SignInButton_Click"/>


                <StackPanel
                    x:Name="LoadingPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="0,20,0,0">

                    <Ellipse
                        Width="7"
                        Height="7"
                        Fill="{DynamicResource WarningBrush}"
                        Margin="0,0,8,0"/>

                    <TextBlock
                        Text="Signing in..."
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="11"
                        VerticalAlignment="Center"/>

                </StackPanel>


                <TextBlock
                    Text="Authentication is required before data is loaded."
                    Foreground="{DynamicResource TextMutedBrush}"
                    FontSize="10"
                    TextAlignment="Center"
                    Margin="0,22,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>