<UserControl x:Class="EthStatistics.Views.ImportExcelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid
            Background="{DynamicResource AppBackgroundBrush}"
            Margin="32">

            <StackPanel MaxWidth="920"
                        HorizontalAlignment="Left">

                <TextBlock
                    Text="Import Excel"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Import a date and price or return series from an Excel workbook"
                    Style="{StaticResource PageSubtitleStyle}"
                    Margin="0,5,0,28"/>


                <!-- FILE -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="Excel Workbook"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                x:Name="SelectedFileText"
                                Text="No file selected"
                                Style="{StaticResource LabelStyle}"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,6,20,0"/>

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Choose File"
                            Width="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ChooseFile_Click"/>

                    </Grid>

                </Border>


                <!-- MAPPING -->

                <Border
                    x:Name="MappingCard"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,16"
                    IsEnabled="False">

                    <StackPanel>

                        <TextBlock
                            Text="Column Mapping"
                            Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock
                            Text="Select the worksheet and identify the date and value columns"
                            Style="{StaticResource LabelStyle}"
                            Margin="0,6,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock
                                    Text="Worksheet"
                                    Style="{StaticResource LabelStyle}"
                                    Margin="0,0,0,7"/>

                                <ComboBox
                                    x:Name="WorksheetComboBox"
                                    DisplayMemberPath="Name"
                                    Style="{StaticResource ProfessionalComboBoxStyle}"
                                    SelectionChanged="WorksheetComboBox_SelectionChanged"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="Date Column"
                                    Style="{StaticResource LabelStyle}"
                                    Margin="0,0,0,7"/>

                                <ComboBox
    x:Name="DateColumnComboBox"
    Style="{StaticResource ProfessionalComboBoxStyle}"
    SelectionChanged="DateColumnComboBox_SelectionChanged"/>

                            </StackPanel>


                            <StackPanel Grid.Column="4">

                                <TextBlock
                                    Text="Value Column"
                                    Style="{StaticResource LabelStyle}"
                                    Margin="0,0,0,7"/>

                                <ComboBox
                                    x:Name="ValueColumnComboBox"
                                    Style="{StaticResource ProfessionalComboBoxStyle}"
                                    SelectionChanged="ValueColumnComboBox_SelectionChanged"/>

                            </StackPanel>

                        </Grid>


                        <!-- DETECTION -->

                        <Border
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,20,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock
                                        Text="Detected Value Type"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        FontWeight="SemiBold"
                                        FontSize="13"/>

                                    <TextBlock
                                        x:Name="DetectedTypeDescriptionText"
                                        Text="Select a value column to detect its type"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        FontSize="11"
                                        Margin="0,5,20,0"/>

                                </StackPanel>

                                <ComboBox
                                    x:Name="ValueTypeComboBox"
                                    Grid.Column="1"
                                    Style="{StaticResource ProfessionalComboBoxStyle}"
                                    VerticalAlignment="Center">

                                    <ComboBoxItem
                                        Content="Price"
                                        Tag="Price"/>

                                    <ComboBoxItem
                                        Content="Percentage Return"
                                        Tag="PercentageReturn"/>

                                </ComboBox>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- IMPORT ACTION -->

                <StackPanel
                    Orientation="Horizontal">

                    <Button
                        x:Name="ImportButton"
                        Content="Import and Analyze"
                        Width="155"
                        IsEnabled="False"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ImportButton_Click"/>

                    <TextBlock
                        x:Name="ImportStatusText"
                        Text=""
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>