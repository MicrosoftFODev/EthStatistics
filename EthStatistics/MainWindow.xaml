<Window x:Class="EthStatistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Crypto Statistics"
        Height="800"
        Width="1320"
        MinHeight="700"
        MinWidth="1100"

        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TOP BAR -->

        <Border
            Grid.Row="0"
            Background="{DynamicResource TopBarBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="220"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- BRAND -->

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Width="30"
                        Height="30"
                        CornerRadius="6"
                        Background="{DynamicResource AccentBrush}"
                        Margin="0,0,11,0">

                        <TextBlock
                            Text="Q"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel>

                        <TextBlock
                            Text="Crypto Statistics"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="15"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="QUANTITATIVE ANALYTICS"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="8"/>

                    </StackPanel>

                </StackPanel>


                <!-- CENTER STATUS -->

                <StackPanel
    Grid.Column="1"
    Orientation="Horizontal"
    VerticalAlignment="Center"
    HorizontalAlignment="Center">

                    <Ellipse
        x:Name="DataStatusIndicator"
        Width="7"
        Height="7"
        Fill="{DynamicResource TextMutedBrush}"
        Margin="0,0,8,0"/>

                    <TextBlock
        x:Name="DataStatusText"
        Text="Waiting for market data"
        Foreground="{DynamicResource TextMutedBrush}"
        FontSize="12"/>

                </StackPanel>


                <!-- USER -->

                <Menu Grid.Column="2"
      Background="Transparent"
      VerticalAlignment="Center">

                    <MenuItem
        Header="User"
        Style="{StaticResource UserMenuItemStyle}">

                        <MenuItem
            Header="Settings"
            Style="{StaticResource UserMenuOptionStyle}"
            Click="SettingsMenuItem_Click"/>

                        <MenuItem
            Header="About"
            Style="{StaticResource UserMenuOptionStyle}"
            Click="AboutMenuItem_Click"/>

                    </MenuItem>

                </Menu>

            </Grid>

        </Border>


        <!-- MAIN AREA -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- SIDEBAR -->

            <Border
                Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Grid.Row="0"
                        Text="ANALYTICS"
                        Foreground="{DynamicResource TextMutedBrush}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="27,25,0,9"/>


                    <StackPanel
                        Grid.Row="1"
                        Margin="12,0">

                        <Button
                            Content="Dashboard"
                            Click="DashboardButton_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                        <Button
                            Content="Chart"
                            Click="ChartButton_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                        <Button
                            Content="Statistics"
                            Click="StatisticsButton_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                        <Button
                            Content="Forecast"
                            Click="ForecastButton_Click"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    </StackPanel>


                    <Border
                        Grid.Row="2"
                        Margin="16"
                        Padding="12"
                        CornerRadius="6"
                        Background="{DynamicResource SurfaceBrush}">

                        <StackPanel>

                            <TextBlock
                                Text="DATA PROVIDER"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="9"/>

                            <TextBlock
                                Text="Kraken"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                FontSize="12"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- PAGE CONTENT -->

            <ContentControl
                x:Name="MainContent"
                Grid.Column="1"
                Background="{DynamicResource AppBackgroundBrush}"/>

        </Grid>

    </Grid>

</Window>