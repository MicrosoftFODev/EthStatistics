<Window x:Class="EthStatistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETH Statistics"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#151A23">

            <StackPanel VerticalAlignment="Center"
                        Margin="25,0">

                <TextBlock Text="ETH Statistics"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"/>

                <TextBlock Text="Ethereum Quantitative Analysis"
                           Foreground="#AAB2C0"
                           FontSize="13"/>

            </StackPanel>

        </Border>

        <!-- CONTROLS -->
        <Grid Grid.Row="1"
              Margin="25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="ETH / USDT"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Daily Market Data"
                           FontSize="13"
                           Foreground="#666666"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Width="140"
                    Height="40"
                    Content="Load ETH Data"
                    Click="LoadData_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>

        </Grid>

        <!-- DATA GRID -->
        <Border Grid.Row="2"
                Margin="25,0,25,25"
                Background="White"
                CornerRadius="8"
                Padding="10">

            <DataGrid x:Name="EthDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding Date}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Open"
                                        Binding="{Binding Open, StringFormat=N2}"
                                        Width="*"/>

                    <DataGridTextColumn Header="High"
                                        Binding="{Binding High, StringFormat=N2}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Low"
                                        Binding="{Binding Low, StringFormat=N2}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Close"
                                        Binding="{Binding Close, StringFormat=N2}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Volume"
                                        Binding="{Binding Volume, StringFormat=N2}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>