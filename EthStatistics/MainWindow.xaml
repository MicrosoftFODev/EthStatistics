<Window x:Class="EthStatistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crypto Statistics"
        Height="760"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->

        <Border Grid.Row="0"
                Background="#111827">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Crypto Statistics"
                    Foreground="White"
                    FontSize="21"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <!-- USER -->

                <Button
                    Grid.Column="1"
                    Width="145"
                    Height="38"
                    Background="#1F2937"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="UserButton_Click">

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="User"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="▼"
                            FontSize="10"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>

        <!-- MAIN BODY -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->

            <Border Grid.Column="0"
                    Background="#1F2937">

                <StackPanel Margin="12,25">

                    <Button
                        Content="Dashboard"
                        Click="DashboardButton_Click"
                        Style="{StaticResource NavigationButtonStyle}"/>

                    <Button
                        Content="Chart"
                        Click="ChartButton_Click"
                        Style="{StaticResource NavigationButtonStyle}"/>

                    <Button
                        Content="Statistics"
                        Click="StatisticsButton_Click"
                        Style="{StaticResource NavigationButtonStyle}"/>

                    <Button
                        Content="Forecast"
                        Click="ForecastButton_Click"
                        Style="{StaticResource NavigationButtonStyle}"/>

                </StackPanel>

            </Border>

            <!-- THIS IS IMPORTANT -->
            <!-- All pages are displayed here -->

            <ContentControl
                x:Name="MainContent"
                Grid.Column="1"/>

        </Grid>

    </Grid>

</Window>